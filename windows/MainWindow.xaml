<Window
    x:Class="StudyBuddyZoneWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StudyBuddyZoneWindows"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Simple local app-shell loader shown until WebView2 finishes
             navigating to the live StudyBuddyZone app. Mirrors www/index.html. -->
        <StackPanel
            x:Name="LoadingPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Visible">
            <Image Source="Assets/Square150x150Logo.png" Width="84" Height="84" />
            <TextBlock Text="Loading StudyBuddyZone..." HorizontalAlignment="Center" />
        </StackPanel>

        <wv2:WebView2
            x:Name="AppWebView"
            Visibility="Collapsed" />
    </Grid>
</Window>
